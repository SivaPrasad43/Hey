rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isMember(roomId) {
      return me() in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Profiles: anyone signed in can read (needed for search + presence); only the owner writes.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me();
    }

    match /rooms/{roomId} {
      // `resource == null` lets a client check whether a DM exists yet; General is visible so people can join it.
      allow read: if signedIn() && (resource == null || roomId == 'general' || me() in resource.data.members);

      allow create: if signedIn()
        && me() in request.resource.data.members
        && request.resource.data.createdBy == me()
        && request.resource.data.type in ['group', 'dm']
        && (request.resource.data.type != 'dm'
            || (request.resource.data.members.size() == 2
                && (roomId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                    || roomId == request.resource.data.members[1] + '_' + request.resource.data.members[0])));

      allow update: if signedIn() && (
        // members: post activity, add people to groups, refresh their own cached name
        (me() in resource.data.members
          && onlyChanges(['lastMessage', 'updatedAt', 'members', 'memberNames'])
          && request.resource.data.members.hasAll(resource.data.members)
          && (resource.data.type == 'group' || request.resource.data.members == resource.data.members))
        // anyone signed in may join the shared General room themself
        || (roomId == 'general'
          && onlyChanges(['members', 'memberNames'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [me()].toSet())
      );

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(roomId);
        // System notices may be written in the same transaction that adds the author to the room.
        allow create: if signedIn()
          && request.resource.data.senderId == me()
          && request.resource.data.type in ['text', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (isMember(roomId) || me() in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.members);
        allow update: if signedIn() && isMember(roomId) && (
          // author edits or soft-deletes their own text message
          (resource.data.senderId == me()
            && resource.data.type == 'text'
            && resource.data.get('deleted', false) == false
            && onlyChanges(['text', 'editedAt', 'deleted'])
            && request.resource.data.text is string
            && (request.resource.data.get('deleted', false) == true
                ? request.resource.data.text == ''
                : request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000))
          // any member sets or clears only their own mood reaction
          || (onlyChanges(['reactions'])
            && request.resource.data.get('reactions', {})
                 .diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()]))
        );
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if signedIn() && isMember(roomId);
        allow write: if signedIn() && uid == me() && isMember(roomId);
      }
    }
  }
}
