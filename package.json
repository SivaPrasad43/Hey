{
  "name": "hey-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:emu": "ng serve --configuration emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project hey-chat-7ea1b",
    "test:rules": "firebase emulators:exec --only auth,firestore --project hey-chat-7ea1b \"node scripts/rules-smoke.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
